def send_mail(to_recipient, to_sender, email_subject, email_body, s3_file_path,
              smtp_server, port, smtp_user, smtp_password, aws_region):
    """
    the function sends out email to the intended recipients
    :param to_recipient: recipient email id as str
    :param to_sender: sender email id as str
    :param email_subject: email subject line as str
    :param email_body: email body as str
    :param s3_file_path: s3 path for the attachment file
    :param smtp_server: smpt server
    :param port: smtp port
    :param smtp_user: smtp user
    :param smtp_password: smtp password
    :param aws_region: aws region as str
    :return :
    """
    logger.info("Inside send_mail function")
    senderAddress = to_sender
    subject = email_subject
    message = email_body

    logger.info(
        f"SENDER {senderAddress} \n RECEIVER {to_recipient} \n "
        f"SUBJECT {subject}\n MESSAGE {message}\n S3_PATH {s3_file_path} \n "
        f"AWS_REGION {aws_region}")

    s3 = boto3.client("s3")

    try:
        logger.info("$$$$$")
        message = message.replace("\n", "<br>")
        # The email body for recipients with non-HTML email clients.
        BODY_TEXT = message
        # The HTML body of the email.
        BODY_HTML = f"""\
        <html>
        <head></head>
        <body>
        {message}
        </body>
        </html>"""

        # The character encoding for the email.
        CHARSET = "utf-8"

        # Create a multipart/mixed parent container.
        msg = MIMEMultipart('mixed')
        # Create a multipart/alternative child container.
        msg_body = MIMEMultipart('alternative')
        # Add subject, from and to lines.
        msg['To'] = to_recipient
        msg['From'] = senderAddress
        msg_body['Subject'] = subject
        # Encode the text and HTML content and set the character encoding.
        # This step is necessary if you're sending a message with characters
        # outside the ASCII range.
        logger.info("Encoding Now")
        textpart = MIMEText(BODY_TEXT.encode(CHARSET), 'plain', CHARSET)
        htmlpart = MIMEText(BODY_HTML.encode(CHARSET), 'html', CHARSET)
        logger.info(type(textpart))
        logger.info(type(htmlpart))

        # Add the text and HTML parts to the child container.
        msg_body.attach(textpart)
        msg_body.attach(htmlpart)
        logger.info("$$$$$$$$$$$$$$$$$$$$$$$$$$$$$")

        # if s3 path for attachment is shared
        if s3_file_path:
            logger.info(f'attachment path shared as arguments: {s3_file_path}')
            # read attachment file from s3 path
            attachment_file = s3.get_object(Bucket=enr_bkt, Key=s3_file_path)
            body = attachment_file['Body'].read()

            # fetch filename from s3 path
            filename = os.path.basename(s3_file_path)
            # define the attachment part and encode it using MIMEApplication.
            part = MIMEApplication(body, filename)
            part.add_header(
                "Content-Disposition", 'attachment', filename=filename)
            # attach file into email body
            msg_body.attach(part)
            logger.info('file attached successfully')

        # Create a secure SSL context
        logger.info("Starting SMTP Connection")
        context = ssl.create_default_context()

        with smtplib.SMTP(smtp_server, port, timeout=15) as server:
            server.set_debuglevel(1)
            server.ehlo()  # Can be omitted
            server.starttls(context=context)  # Secure the connection
            server.ehlo()  # Can be omitted
            server.login(smtp_user, smtp_password)
            logger.info("Sending now")
            server.sendmail(senderAddress, to_recipient, msg_body.as_string())

    except Exception as e:
        logger.info(str(e))
        return str(e)


def getInfo(dynomodb_tab, pass_val_PPK, pass_val_PSK, col_PPK, col_PSK,
            dynamodb):
    try:
        table = dynamodb.Table(dynomodb_tab)
        response = table.query(
            KeyConditionExpression=Key(col_PPK).eq(pass_val_PPK) & Key(
                col_PSK).eq(pass_val_PSK)
        )

        if not response['Items']:
            logger.warning("No items found in table '%s' for PPK: %s, PSK: %s",
                           dynomodb_tab, pass_val_PPK, pass_val_PSK)
            return []

        nameList = response['Items']
        while 'LastEvaluatedKey' in response:
            response = table.query(
                KeyConditionExpression=Key(col_PPK).eq(pass_val_PPK) & Key(
                    col_PSK).eq(pass_val_PSK),
                ExclusiveStartKey=response['LastEvaluatedKey']
            )
            nameList.extend(response['Items'])

        return nameList
    except Exception as e:
        logger.error(
            "Error occurred in getInfo() for table '%s' with PPK: %s, PSK: %s. Error: %s",
            dynomodb_tab, pass_val_PPK, pass_val_PSK, e)
        return []


"""This will get the secret details from secret manager."""


def get_secret(secret_name, region_name):
    # Create a Secrets Manager client
    session = boto3.session.Session()
    client = session.client(service_name='secretsmanager',
                            region_name=region_name)
    get_secret_value_response = client.get_secret_value(SecretId=secret_name)
    secret_string = json.loads(get_secret_value_response['SecretString'])
    return secret_string


"""This will get event details from Stepfunction"""


def getEvent(event):
    dynamodb = boto3.resource('dynamodb', 'us-east-1')
    dic = {}
    if event.get('Error'):
        if 'Error' in event.keys():
            try:
                fileGroupId = eval(event.get('Cause', "[]")).get(
                    "Arguments", "Not Available").get("--FILE_GROUP_ID", "")
                loadId = eval(event.get('Cause', "[]")).get(
                    "Arguments", "Not Available").get("--LOAD_ID", "")
                job_country = eval(event.get('Cause', "[]")).get(
                    "Arguments", "Not Available").get("--JOB_COUNTRY", "")
                status = "Failed"
                src_sys_nm = eval(event.get('Cause', "[]")).get(
                    "Arguments", "Not Available").get("--SOURCE_NAME", "")
                job_name = eval(event.get('Cause', "[]")).get(
                    "Arguments", "Not Available").get("--JOB_NAME", "")
                error_message = eval(event.get('Cause', "[]")).get(
                    "ErrorMessage", "")
                job_id = eval(event.get('Cause', "[]")).get("Id", "")

                logger.info(
                    f'Country:{job_country} \n Job_Name:{job_name} '
                    f'\n Job_Id:{job_id} \n Error_Message:{error_message}')

                if job_name == "bay-modeln-model-job-us-east-1":
                    layer = 'Model'
                elif job_name == "bay-modeln-fetch-source-file-to-S3":
                    layer = 'Landing'
                elif job_name == "bay-modeln-raw-job-us-east-1":
                    layer = 'Raw'
                elif job_name == "bay-modeln-enriched-job-us-east-1":
                    layer = 'Enriched'
                else:
                    layer = 'SFTP'
            except:
                try:
                    if event.get('Cause'):
                        logger.info(event.get('Cause'))
                        error = \
                            event.get('Cause').split(":", 2)[2].split('"')[0]
                        error = ast.literal_eval(error)
                        fileGroupId = error.get("fileGroupID")
                        src_sys_nm = error.get("sourceSystemName")
                        layer = error.get("layer")
                        status = error.get("status")
                        error_message = error.get('Error')
                        job_country = error.get("job_country")
                        job_name = error.get(
                            "job_name") if 'job_name' in error.keys() else "NA"
                        job_id = \
                            event.get("Id") if 'Id' in error.keys() else "NA"
                    try:
                        if 'loadId' in error.keys():
                            loadId = error.get("loadId")
                        else:
                            # trying to fetch loadid from stepfunction
                            # audit table
                            batch_audit_table = dynamodb.Table(
                                "bay-modeln-stepfunction-audit-table")
                            response = batch_audit_table.query(
                                KeyConditionExpression=Key("fileGroupID").eq(
                                    fileGroupId)
                            )
                            tmpDict = response['Items'][0]
                            loadId = error.get(
                                "loadId") if 'loadId' in error.keys() else \
                                tmpDict[
                                    'currentRunLoadId'] if 'currentRunLoadId' in tmpDict else datetime.strftime(
                                    datetime.utcnow(), '%Y%m%d%H%M%S')
                    except:
                        # using timestamp as loadid in exception case
                        loadId = datetime.strftime(datetime.utcnow(),
                                                   '%Y%m%d%H%M%S')

                except Exception as e:
                    logger.info(f"Error While Parsing Event: {str(e)}")

        dic['fileGroupID'] = fileGroupId
        dic['sourceSystemName'] = src_sys_nm
        dic['loadId'] = loadId
        dic['status'] = status
        dic['layer'] = layer
        dic['error_message'] = error_message
        dic['job_country'] = job_country
        dic['job_name'] = job_name
        dic['job_id'] = job_id
    elif event.get('lng_loadId'):
        dic['fileGroupID'] = event.get("fileGroupID")
        dic['sourceSystemName'] = event.get("sourceSystemName")
        dic['loadId'] = event.get("lng_loadId")
        dic['status'] = "Successful"
        dic['error_message'] = event.get(
            'Cause') if 'Cause' in event.keys() else "Invalid ProcessRunStatus"
    else:
        if 'loadId' in event.keys():
            LOADId = event['loadId']
        else:
            LOADId = datetime.strftime(datetime.utcnow(), '%Y%m%d%H%M%S')
        dic['fileGroupID'] = event.get("fileGroupID")
        dic['sourceSystemName'] = event.get("sourceSystemName")
        dic['loadId'] = LOADId
        dic['status'] = "Running"
    return dic
