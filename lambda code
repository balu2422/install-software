def get_s3_matchs(file_pattern, bkt, key, extension):
    """
    fetches s3 file keys for the files matches with the patterns
    and return as a dict
    :param file_pattern: file name format as str
    :param bkt: bucket name as str
    :param key: file key as str
    :param extension: file type as str
    :return file_key: s3 key as str
    """
    try:
        # list s3 objects for the given s3 path
        response = s3.list_objects_v2(Bucket=bkt, Prefix=key)

        # if the given s3 path is empty
        if 'Contents' not in response:
            error_msg = f"No files found in the specified path: {key} in {bkt}"
            logger.error(f"No files found in the specified path: {key}")
            sys.exit(error_msg)

        logger.info(
            f'checking file pattern {file_pattern} in s3://{bkt}/{key}')
        matched_file_path = ''
        # iterate through s3 objects
        for content in response['Contents']:
            # get file path
            file_path = content['Key']
            # get file name
            filename = os.path.basename(file_path)

            # check file name for pattern and extension match
            if fnmatch.fnmatch(filename, file_pattern) and filename.endswith(
                    extension):
                matched_file_path = file_path
                logger.info(f'file match found: {matched_file_path}')
                break

        # if match dict is empty
        if not matched_file_path:
            error_msg = f'No files found for any of the file patterns' \
                        f'({file_pattern}) in s://{bkt}/{key}'
            logger.error(error_msg)
            sys.exit(error_msg)

        return matched_file_path

    # in case of failure in fn
    except Exception as e:
        error_msg = f'Error in get_s3_matchs fn, error: {e}'
        logger.error(error_msg)
        sys.exit(error_msg)
def get_s3_file_size(bucket_name, file_path):
    """Helper function to get the size of the file in S3."""
    s3_client = boto3.client('s3', region_name='us-east-1')
    response = s3_client.head_object(Bucket=bucket_name, Key=file_path)
    return response['ContentLength']  # Size of the file in bytes


